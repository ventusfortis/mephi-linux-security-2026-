   56  sudo cat /etc/sudoers > ~/mephi-artifacts/etc/sudoers
   57  cp ~/stat.out ~/getcap.out ~/setuid-files.out ~/processes.out ~/setuid-demo.out ~/capability-demo.out ~/sudo-demo.out ~/mephi-artifacts/
