    1  sudo groupadd students
    2  sudo useradd -u 1234 -G students -m -s /bin/bash user1
    3  sudo passwd user1
    4  sudo chage -M 90 user1
    5  id user1
    6  sudo chage -l user1
    7  sudo find / -perm -4000 -type f 2>/dev/null | head -n 15
    8  ps -eo pid,ruid,euid,comm | awk 'NR==1 || ($3 == 0 && $2 != 0)'
    9  cat /etc/shadow
   10  sudo -l
   11  sudo nano /etc/ssh/sshd_config
   12  ip a
   13  sudo systemctl status sshd
   14  sudo systemctl enable sshd --now
   15  getent group students || sudo groupadd students
   16  getent passwd user1 || sudo useradd -u 1234 -G students -m -s /bin/bash user1
   17  sudo usermod -aG students user1
   18  sudo chown -R user1:user1 /home/user1
   19  echo 'Student2026!' | sudo passwd --stdin user1
   20  sudo chage -M 90 -W 7 user1
   21  sudo chage -l user1
   22  id user1
   23  grep -E '^(user1|students):' /etc/passwd /etc/group
   24  sudo grep '^user1:' /etc/shadow
   25  stat /home/user1
   26  sudo find / -path /proc -prune -o -type f -perm -4000 -exec ls -l {} + 2>/dev/null | tee ~/setuid-files.out
   27  ps -eo pid,ruser,euser,ruid,euid,comm | awk 'NR==1 || ($5==0 && $4!=0)' | tee ~/processes.out
