   29  cat /etc/shadow
   30  cp /usr/bin/cat ~/my_cat
   31  sudo chown root:root ~/my_cat
   32  sudo chmod u+s ~/my_cat
   33  ls -l ~/my_cat
   34  ~/my_cat /etc/shadow | head -n 3
   35  ~/my_cat /etc/shadow | grep '^user1:' | tee ~/setuid-demo.out
   36  touch ~/testfile.txt
   37  chown root ~/testfile.txt
   38  cp /usr/bin/chown ~/my_chown
   39  sudo setcap cap_chown=ep ~/my_chown
   40  getcap ~/my_chown
   41  ~/my_chown root ~/testfile.txt
   42  ls -l ~/testfile.txt | tee ~/capability-demo.out
   43  sudo visudo -c
   44  sudo grep -n '^user1' /etc/sudoers
   45  sudo -l -U user1
   46  echo 'Student2026!' | sudo -u user1 sudo -S date -s "$(date '+%Y-%m-%d %H:%M:%S')" 2>&1 | tee ~/sudo-demo.out
   47  echo 'Student2026!' | sudo -u user1 sudo -S cat /etc/shadow 2>&1 | tee -a ~/sudo-demo.out
   48  mkdir -p ~/mephi-artifacts/etc
